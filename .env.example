# Binance (optional, only needed if you want authenticated endpoints later)
# BINANCE_API_KEY=your_binance_key
# BINANCE_API_SECRET=your_binance_secret

# Real LLM APIs (leave empty to use local rule-based analyzers)
DEEPSEEK_API_KEY=sk-...
XAI_API_KEY=xai-...

# Model schedule (cost-optimized three-tier)
# 1-min  : deepseek-v4-flash (fast & cheap)
# 15-min : deepseek-v4-pro   (deeper reasoning, still cheap)
# 2-hr   : grok-4.3          (expensive, used only for deep review + self-correction)
DEEPSEEK_MODEL=deepseek-v4-flash     # used for 1-min fast decisions
DEEPSEEK_PRO_MODEL=deepseek-v4-pro   # used for 15-min medium decisions
XAI_MODEL=grok-4.3                   # used every 2 hours for review

# Telegram notifications (optional)
# Get bot token from @BotFather and chat ID from @userinfobot
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# TELEGRAM_CHAT_ID=987654321
